{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Per-Claude-account rate-limit budget usage from the standalone claude-limits monitor (claude_limits.* metrics). One column per account: usage % vs. time-elapsed % of window (stacked bars, same row order, for at-a-glance pace comparison), resets-in duration, and a per-account trend line. Accounts are labelled by claude_limits_account_alias; the technical slice key is service_instance_id.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "liveNow": false,
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["claude", "account", "limits", "usage", "prometheus"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(claude_limits_account_utilization_ratio, claude_limits_account_alias)",
        "includeAll": true,
        "multi": true,
        "name": "account",
        "query": {
          "qryType": 1,
          "query": "label_values(claude_limits_account_utilization_ratio, claude_limits_account_alias)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "name": "window",
        "options": [
          { "selected": true, "text": "5-hour", "value": "five_hour" },
          { "selected": true, "text": "7-day", "value": "seven_day" }
        ],
        "query": "five_hour, seven_day",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "3h", "6h", "12h", "24h", "7d"]
  },
  "timezone": "browser",
  "title": "Claude — Account Usage",
  "uid": "claude-account-usage",
  "version": 6,
  "weekStart": "",
  "panels": [
    {
      "type": "row",
      "title": "Usage vs. Time Elapsed — $account",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": []
    },
    {
      "id": 1,
      "type": "bargauge",
      "title": "$account — % of Limit Used",
      "description": "Fraction of each rate-limit window consumed. Compare row-for-row against the 'Time Elapsed in Window' panel directly below — if 'used' is far ahead of 'elapsed' for the same window, this account is burning faster than a linear pace and will exhaust before reset.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "repeat": "account",
      "repeatDirection": "h",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(claude_limits_account_utilization_ratio{claude_limits_window=\"five_hour\", claude_limits_model=\"all\", claude_limits_account_alias=~\"$account\", claude_limits_account_alias!=\"\", job=\"otel-collector\"})",
          "legendFormat": "5h used",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(claude_limits_account_utilization_ratio{claude_limits_window=\"seven_day\", claude_limits_model=\"all\", claude_limits_account_alias=~\"$account\", claude_limits_account_alias!=\"\", job=\"otel-collector\"})",
          "legendFormat": "7d used",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "$account — Time Elapsed in Window",
      "description": "How far through each rate-limit window we currently are (1 − remaining/window length). At a linear burn rate, this should track roughly even with the 'used' bar above it for the same window.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "repeat": "account",
      "repeatDirection": "h",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp(1 - (max(claude_limits_account_reset_time_seconds{claude_limits_window=\"five_hour\", claude_limits_model=\"all\", claude_limits_account_alias=~\"$account\", claude_limits_account_alias!=\"\", job=\"otel-collector\"}) - time()) / 18000, 0, 1) or on() vector(0)",
          "legendFormat": "5h elapsed",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp(1 - (max(claude_limits_account_reset_time_seconds{claude_limits_window=\"seven_day\", claude_limits_model=\"all\", claude_limits_account_alias=~\"$account\", claude_limits_account_alias!=\"\", job=\"otel-collector\"}) - time()) / 604800, 0, 1) or on() vector(0)",
          "legendFormat": "7d elapsed",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 3,
      "type": "bargauge",
      "title": "$account — Resets In",
      "description": "Time remaining until each window rolls over, shown as a fraction of the full window length. Auto-scales precision: days+hours when far out, hours+minutes as reset gets close. An idle window (no usage yet) has nothing to count down to, so it reads as 0 remaining until first use opens it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "repeat": "account",
      "repeatDirection": "h",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(max(claude_limits_account_reset_time_seconds{claude_limits_window=\"five_hour\", claude_limits_model=\"all\", claude_limits_account_alias=~\"$account\", claude_limits_account_alias!=\"\", job=\"otel-collector\"}) - time(), 0) or on() vector(0)",
          "legendFormat": "5h resets in",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "clamp_min(max(claude_limits_account_reset_time_seconds{claude_limits_window=\"seven_day\", claude_limits_model=\"all\", claude_limits_account_alias=~\"$account\", claude_limits_account_alias!=\"\", job=\"otel-collector\"}) - time(), 0) or on() vector(0)",
          "legendFormat": "7d resets in",
          "instant": true,
          "range": false,
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "decimals": 1,
          "min": 0,
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }] },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "5h resets in" },
            "properties": [{ "id": "max", "value": 18000 }]
          },
          {
            "matcher": { "id": "byName", "options": "7d resets in" },
            "properties": [{ "id": "max", "value": 604800 }]
          }
        ]
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" },
        "text": { "valueSize": 16 }
      }
    },
    {
      "type": "row",
      "title": "Trends",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 101,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "$account — Utilization Over Time",
      "description": "This account's burn velocity across the range, one line per window. Dashed lines mark the 80% and 95% ceilings. Default range is 7 days so both the 5-hour and 7-day cycles are guaranteed to be visible.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "repeat": "account",
      "repeatDirection": "h",
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 23 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (claude_limits_window) (claude_limits_account_utilization_ratio{claude_limits_window=~\"$window\", claude_limits_model=\"all\", claude_limits_account_alias=~\"$account\", claude_limits_account_alias!=\"\", job=\"otel-collector\"})",
          "legendFormat": "{{claude_limits_window}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.95 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"],
          "showLegend": true,
          "sortBy": "Last *",
          "sortDesc": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Auth Status",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 102,
      "panels": []
    },
    {
      "id": 5,
      "type": "table",
      "title": "Auth Status",
      "description": "OAuth login validity per account. RE-LOGIN (red) means the identity needs an interactive re-login. This gauge is the only wired auth signal today (the auth log event is a v1 fast-follow).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 33 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "min by (claude_limits_account_alias) (claude_limits_account_auth_active{claude_limits_account_alias=~\"$account\", claude_limits_account_alias!=\"\", job=\"otel-collector\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "renameByName": { "claude_limits_account_alias": "Account", "Value": "Auth" },
            "indexByName": { "claude_limits_account_alias": 0, "Value": 1 }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "color-background" }, "filterable": true },
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "RE-LOGIN", "color": "red", "index": 0 },
              "1": { "text": "OK", "color": "green", "index": 1 }
            } }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Account" },
            "properties": [ { "id": "custom.cellOptions", "value": { "type": "auto" } } ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      }
    }
  ]
}
