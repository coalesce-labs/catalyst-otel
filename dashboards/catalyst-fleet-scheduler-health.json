            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max(histogram_quantile(0.99, sum by (host_name, le) (rate(catalyst_scheduler_pass_duration_seconds_bucket{pass=\"recovery-pass\"}[1h]))))",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "title": "Recovery-pass p99 (1h)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Count of liveness-refresh timeouts. outcome=timeout \u21d2 new-work admission held \u21d2 the wedge. Any > 0 is a signal.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(catalyst_liveness_refresh_total{liveness_outcome=\"timeout\"}[1h])) or vector(0)",
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ],
      "title": "Liveness timeouts (1h)",
      "type": "stat"
