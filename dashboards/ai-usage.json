{
  "uid": "ai-usage",
  "title": "AI Usage",
  "description": "Unified cross-provider AI spend/usage dashboard -- Claude Code (real $, native cost telemetry) + Codex (ESTIMATED $ at API list price -- runs on a ChatGPT Plan Pro subscription with no real cost telemetry, see provisioning/prometheus/codex-price-table.md). Real and estimated dollars are NEVER summed into one number anywhere on this dashboard -- always separate panels/series, always labeled. Built on the ai:tokens:sum / ai:tool_calls:sum / ai:cost_usd:sum canonical recording rules (provisioning/prometheus/recording-rules.yml) plus Loki panels for signals that don't exist in Prometheus yet (Codex headless tokens/cost). Designed to take a third provider (e.g. OpenRouter) by adding a recording-rule leg -- see the design note row at the bottom.",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "browser",
  "refresh": "1m",
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "tags": [
    "ai-usage",
    "cost",
    "observability"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "bucket",
        "type": "interval",
        "label": "Interval",
        "query": "5m,15m,30m,1h,6h,1d",
        "current": {
          "text": "1h",
          "value": "1h"
        },
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "options": [],
        "refresh": 2,
        "hide": 0
      },
      {
        "name": "provider",
        "type": "query",
        "label": "Provider",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(ai:tool_calls:sum, provider)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "model",
        "type": "query",
        "label": "Model",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(ai:cost_usd:sum, model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "project",
        "type": "query",
        "label": "Project",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(ai:cost_usd:sum, project)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "linear_key",
        "type": "query",
        "label": "Ticket",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(ai:cost_usd:sum, linear_key)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "account",
        "type": "query",
        "label": "Account",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(ai:cost_usd:sum, account)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "AI Usage — Overview (real $ + estimated $, kept separate)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Claude Spend (real $)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(max_over_time(ai:cost_usd:sum{provider=\"anthropic\",linear_key=~\"$linear_key\",project=~\"$project\",account=~\"$account\"}[$__range]))",
          "legendFormat": "Claude Spend (real $)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5794F2",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "description": "REAL dollars -- native claude_code_cost_usage_USD_total via the ai:cost_usd:sum recording rule."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Codex Spend (ESTIMATED, list price)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "(sum(sum_over_time({service_name=\"codex_exec\"} | event_name=\"codex.sse_event\" | model=\"gpt-5.6-sol\" | linear_key=~\"$linear_key\" | unwrap input_token_count [$__range])) - sum(sum_over_time({service_name=\"codex_exec\"} | event_name=\"codex.sse_event\" | model=\"gpt-5.6-sol\" | linear_key=~\"$linear_key\" | unwrap cached_token_count [$__range]))) * 0.000004 + sum(sum_over_time({service_name=\"codex_exec\"} | event_name=\"codex.sse_event\" | model=\"gpt-5.6-sol\" | linear_key=~\"$linear_key\" | unwrap cached_token_count [$__range])) * 0.0000004 + sum(sum_over_time({service_name=\"codex_exec\"} | event_name=\"codex.sse_event\" | model=\"gpt-5.6-sol\" | linear_key=~\"$linear_key\" | unwrap output_token_count [$__range])) * 0.00002",
          "legendFormat": "Codex Spend (ESTIMATED, list price)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#FF9830",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false,
          "fields": ""
        }
      },
      "description": "ESTIMATED @ OpenAI's published API list price. Codex runs on a ChatGPT Plan Pro SUBSCRIPTION -- verified no real cost/credit telemetry exists anywhere (see provisioning/prometheus/codex-price-table.md). NOT a real charge -- do not sum with the Claude panel."
    },
