          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "queryType": "range",
          "expr": "{service_name=~\"${service:pipe}\"} |= `catalyst.install`"
        }
      ],
      "title": "Install run feed \u2014 expand a row, click trace_id \u2192 root-span flame graph (Tempo)",
      "type": "logs"
    }
  ],
