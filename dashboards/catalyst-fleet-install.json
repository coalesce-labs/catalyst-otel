      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (operation) (increase(catalyst_install_total{catalyst_node_class=~\"$node_class\"}[$__range]))",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{operation}}",
          "format": "table"
        }
      ],
      "title": "Runs by operation (range)",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Where installs break: bare install occurrences by event_action (started / phase / completed / failed / rolled_back) and host. Sourced from catalyst_event_total{event_entity=\"install\"}, which is always present once installs run (independent of the gated duration histogram).",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "unit": "short",
          "noValue": "No data yet"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 10,
        "y": 25
      },
      "id": 9,
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (event_action, operation, host_name) (increase(catalyst_event_total{event_entity=\"install\",catalyst_node_class=~\"$node_class\"}[$__range]))",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "event_action": "Action",
              "operation": "Operation",
              "host_name": "Host",
              "Value": "Count"
            }
          }
        }
      ],
      "title": "Install stages \u2014 occurrences by action (where installs break)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Live catalyst.install lifecycle events. Expand a row \u2192 the trace_id field carries a 'View Trace in Tempo' link (Loki derivedField) \u2192 opens that run's root-span flame graph. Empty until the first real install emits (adoption / PR2).",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 33
      },
      "id": 10,
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
