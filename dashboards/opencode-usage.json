      "id": 16,
      "type": "timeseries",
      "title": "LLM Call Duration p50 / p95 by Model",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(opencode_llm_duration_seconds_bucket{model=~\"$model\",provider=~\"$provider\",host_name=~\"$host_name\"}[5m])))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(opencode_llm_duration_seconds_bucket{model=~\"$model\",provider=~\"$provider\",host_name=~\"$host_name\"}[5m])))",
          "legendFormat": "p95 {{model}}",
          "refId": "B"
