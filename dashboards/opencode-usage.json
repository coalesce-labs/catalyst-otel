{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "OpenCode — Usage (derived from ai.* spans, OTL-99)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "LLM Calls",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(opencode_llm_calls_total{model=~\"$model\",provider=~\"$provider\",project=~\"$project\",branch=~\"$branch\",host_name=~\"$host_name\"}[$__range])) or vector(0)",
          "legendFormat": "Calls",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#5794F2", "value": null }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Input Tokens",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(opencode_llm_input_tokens_total{model=~\"$model\",provider=~\"$provider\",project=~\"$project\",branch=~\"$branch\",host_name=~\"$host_name\"}[$__range])) or vector(0)",
          "legendFormat": "Input",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#73BF69", "value": null }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Output Tokens",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(opencode_llm_output_tokens_total{model=~\"$model\",provider=~\"$provider\",project=~\"$project\",branch=~\"$branch\",host_name=~\"$host_name\"}[$__range])) or vector(0)",
          "legendFormat": "Output",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#FF9830", "value": null }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache Hit Rate",
      "description": "cachedInputTokens / inputTokens. Input tokens INCLUDE cache reads, so this is the share of prompt tokens served from cache.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(opencode_llm_cached_input_tokens_total{model=~\"$model\",provider=~\"$provider\",project=~\"$project\",branch=~\"$branch\",host_name=~\"$host_name\"}[$__range])) / clamp_min(sum(increase(opencode_llm_input_tokens_total{model=~\"$model\",provider=~\"$provider\",project=~\"$project\",branch=~\"$branch\",host_name=~\"$host_name\"}[$__range])), 1)",
          "legendFormat": "Cache Hit",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#73BF69", "value": null },
              { "color": "#F2CC0C", "value": 0.5 },
              { "color": "#F2495C", "value": 0.2 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "LLM Error Rate",
      "description": "error-status LLM calls / total LLM calls. Zero-usage (no calls in range) shows 0, not an error.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(sum(increase(opencode_llm_errors_total{model=~\"$model\",provider=~\"$provider\",project=~\"$project\",branch=~\"$branch\",host_name=~\"$host_name\"}[$__range])) or vector(0)) / clamp_min((sum(increase(opencode_llm_calls_total{model=~\"$model\",provider=~\"$provider\",project=~\"$project\",branch=~\"$branch\",host_name=~\"$host_name\"}[$__range])) or vector(1)), 1)",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#73BF69", "value": null },
              { "color": "#F2CC0C", "value": 0.02 },
              { "color": "#F2495C", "value": 0.1 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "TTFT p50",
      "description": "Time to first token, median, over the range (ai.response.msToFirstChunk).",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (increase(opencode_llm_ttft_seconds_bucket{model=~\"$model\",provider=~\"$provider\"}[$__range]))) or vector(0)",
          "legendFormat": "TTFT p50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#5794F2", "value": null },
              { "color": "#F2CC0C", "value": 5 },
              { "color": "#F2495C", "value": 15 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Tokens & Calls",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Token Rate by Model (input / output, per second)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (model) (rate(opencode_llm_input_tokens_total{model=~\"$model\",provider=~\"$provider\",project=~\"$project\",branch=~\"$branch\",host_name=~\"$host_name\"}[5m]))",
          "legendFormat": "{{model}} in",
          "refId": "A"
        },
        {
          "expr": "sum by (model) (rate(opencode_llm_output_tokens_total{model=~\"$model\",provider=~\"$provider\",project=~\"$project\",branch=~\"$branch\",host_name=~\"$host_name\"}[5m]))",
          "legendFormat": "{{model}} out",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": { "mode": "none" }
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "A-out" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "#FF9830", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["max", "mean", "sum"]
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
