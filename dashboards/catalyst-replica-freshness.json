  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "node", "label": "node", "type": "custom",
        "query": "mini, mini-2, laptop : Ryans-MacBook-Pro-2",
        "definition": "mini, mini-2, laptop : Ryans-MacBook-Pro-2",
        "includeAll": true, "multi": true, "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] }, "refresh": 2, "sort": 1
      }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "text", "id": 1, "transparent": true, "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": { "mode": "markdown", "content": "## Catalyst · Replica Freshness — how out of date is each node?\n**Top row = replica AGE per node** (lower = fresher; this is the number to watch). **Linear** reports its staleness directly (ms). **GitHub** has no staleness field, so we show *time since its last apply* (\"X ago\"). Nodes: **mini**, **mini-2**, **laptop** (`Ryans-MacBook-Pro-2`). Below: the cloud mirror watermark, then trends — including **apply rate** (that's *activity / throughput*, i.e. how many rows/sec are syncing — NOT freshness). Cloud fields come from the Loki JSON body via `regexp`+`unwrap` (no Prometheus pipeline for catalyst-cloud)." }
    },
    { "type": "row", "title": "Headline — how out of date is each node?", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 }, "id": 2, "collapsed": false },

    { "type": "stat", "title": "mini · Linear replica age", "id": 10, "gridPos": { "h": 5, "w": 4, "x": 0, "y": 4 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "last_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | host_name=`mini` | regexp `\"catalyst.linear.replica.staleness\":(?P<v>[0-9]+)` | unwrap v [5m])", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30000 }, { "color": "red", "value": 120000 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" } },
    { "type": "stat", "title": "mini-2 · Linear replica age", "id": 11, "gridPos": { "h": 5, "w": 4, "x": 4, "y": 4 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "last_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | host_name=`mini-2` | regexp `\"catalyst.linear.replica.staleness\":(?P<v>[0-9]+)` | unwrap v [5m])", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30000 }, { "color": "red", "value": 120000 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" } },
    { "type": "stat", "title": "laptop · Linear replica age", "id": 12, "gridPos": { "h": 5, "w": 4, "x": 8, "y": 4 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "last_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | host_name=`Ryans-MacBook-Pro-2` | regexp `\"catalyst.linear.replica.staleness\":(?P<v>[0-9]+)` | unwrap v [5m])", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "ms", "noValue": "no data", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30000 }, { "color": "red", "value": 120000 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" } },
    { "type": "stat", "title": "mini · GitHub last apply", "id": 13, "gridPos": { "h": 5, "w": 4, "x": 12, "y": 4 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service_name=\"catalyst.cloud-sync\"} |= `catalyst.replica.apply` |= `\"source\":\"github\"` | host_name=`mini` | regexp `\"time\":(?P<t>[0-9]+)` | unwrap t [1h]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "dateTimeFromNow", "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" } },
    { "type": "stat", "title": "mini-2 · GitHub last apply", "id": 14, "gridPos": { "h": 5, "w": 4, "x": 16, "y": 4 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service_name=\"catalyst.cloud-sync\"} |= `catalyst.replica.apply` |= `\"source\":\"github\"` | host_name=`mini-2` | regexp `\"time\":(?P<t>[0-9]+)` | unwrap t [1h]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "dateTimeFromNow", "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" } },
    { "type": "stat", "title": "laptop · GitHub last apply", "id": 15, "gridPos": { "h": 5, "w": 4, "x": 20, "y": 4 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service_name=\"catalyst.cloud-sync\"} |= `catalyst.replica.apply` |= `\"source\":\"github\"` | host_name=`Ryans-MacBook-Pro-2` | regexp `\"time\":(?P<t>[0-9]+)` | unwrap t [1h]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "dateTimeFromNow", "noValue": "no data", "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" } },

    { "type": "row", "title": "Cloud mirror (upstream watermark)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "id": 3, "collapsed": false },
    { "type": "stat", "title": "Cloud head watermark · linear", "id": 20, "gridPos": { "h": 4, "w": 6, "x": 0, "y": 10 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service_namespace=\"catalyst-cloud\"} |= `ingest.committed` |= `\"source\":\"linear\"` | regexp `\"headSeq\":(?P<h>[0-9]+)` | unwrap h [10m]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" } },
    { "type": "stat", "title": "Cloud head watermark · github", "id": 21, "gridPos": { "h": 4, "w": 6, "x": 6, "y": 10 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service_namespace=\"catalyst-cloud\"} |= `ingest.committed` |= `\"source\":\"github\"` | regexp `\"headSeq\":(?P<h>[0-9]+)` | unwrap h [10m]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" } },
    { "type": "stat", "title": "Time since last cloud ingest", "id": 22, "gridPos": { "h": 4, "w": 6, "x": 12, "y": 10 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service_namespace=\"catalyst-cloud\"} |= `ingest.committed` | regexp `\"receivedAt\":(?P<r>[0-9]+)` | unwrap r [15m]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "dateTimeFromNow", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" } },
    { "type": "stat", "title": "Silent drops (deduped) · 1h", "id": 23, "gridPos": { "h": 4, "w": 6, "x": 18, "y": 10 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({service_namespace=\"catalyst-cloud\"} |= `ingest.committed` |= `\"deduped\":true` [1h]))", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },

    { "type": "row", "title": "Trends", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "id": 4, "collapsed": false },
    {
      "type": "timeseries", "title": "Linear replica age per node (staleness over time)", "id": 30, "gridPos": { "h": 7, "w": 24, "x": 0, "y": 15 },
      "description": "How out of date each node's Linear replica is, over time. Lower = fresher.",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "avg_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | host_name=~`$node` | regexp `\"catalyst.linear.replica.staleness\":(?P<s>[0-9]+)` | unwrap s [$__interval]) by (host_name)", "queryType": "range", "legendFormat": "{{host_name}}" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "max", "mean"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Replica apply rate by source & result — ACTIVITY (throughput, not freshness)", "id": 31, "gridPos": { "h": 7, "w": 24, "x": 0, "y": 22 },
      "description": "How many rows/interval are being applied, by source (linear/github) and result. This is sync ACTIVITY, not staleness — a busy node and an idle-but-fresh node both look healthy here. result=failed in red.",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (source, result)(count_over_time({service_name=\"catalyst.cloud-sync\"} |= `catalyst.replica.apply` | host_name=~`$node` | regexp `\"result\":\"(?P<result>[a-z]+)\"` | regexp `\"source\":\"(?P<source>[a-z_]+)\"` [$__interval]))", "queryType": "range", "legendFormat": "{{source}} {{result}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*failed.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "sum"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Node cursor per node + cloud head watermark (Linear)", "id": 32, "gridPos": { "h": 7, "w": 24, "x": 0, "y": 29 },
      "description": "Per-node Linear replica cursor vs the cloud headSeq. Separate series — node cursor and cloud head are related but NOT the same seq space, so don't read a naive subtraction as lag.",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "last_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | host_name=~`$node` | regexp `\"catalyst.linear.replica.cursor\":(?P<c>[0-9]+)` | unwrap c [$__interval]) by (host_name)", "queryType": "range", "legendFormat": "cursor {{host_name}}" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service_namespace=\"catalyst-cloud\"} |= `ingest.committed` |= `\"source\":\"linear\"` | regexp `\"headSeq\":(?P<h>[0-9]+)` | unwrap h [$__interval]))", "queryType": "range", "legendFormat": "cloud headSeq" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [ { "matcher": { "id": "byName", "options": "cloud headSeq" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Cloud ingest rate by source", "id": 33, "gridPos": { "h": 7, "w": 24, "x": 0, "y": 36 },
      "description": "Rows/interval landing at the cloud mirror by source (upstream of the nodes).",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (src)(count_over_time({service_namespace=\"catalyst-cloud\"} |= `ingest.committed` | regexp `\"source\":\"(?P<src>[a-z_]+)\"` [$__interval]))", "queryType": "range", "legendFormat": "{{src}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } } },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["last", "sum"] }, "tooltip": { "mode": "multi" } }
    },

    { "type": "row", "title": "Failures", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 }, "id": 5, "collapsed": false },
    {
      "type": "logs", "title": "Failed replica applies — err_message (CTL-1402)", "id": 40, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 44 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service_name=\"catalyst.cloud-sync\"} |= `catalyst.replica.apply` |= `\"result\":\"failed\"` | host_name=~`$node`", "queryType": "range" } ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none" }
    }
  ]
}
