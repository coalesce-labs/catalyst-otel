{
  "uid": "catalyst-fleet-daemon-logs",
  "title": "Catalyst — Fleet Daemon Logs",
  "tags": [
    "catalyst",
    "logs",
    "fleet"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": "label_values(service_name)",
        "definition": "label_values(service_name)",
        "regex": "/^catalyst\\.(broker|execution-core|monitor|otel-forward)$/",
        "includeAll": true,
        "multi": true,
        "allValue": "catalyst.(broker|execution-core|monitor|otel-forward)",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "node",
        "label": "node",
        "type": "custom",
        "query": "mini,mini-2,laptop",
        "options": [
          {
            "text": "mini",
            "value": "mini",
            "selected": false
          },
          {
            "text": "mini-2",
            "value": "mini-2",
            "selected": false
          },
          {
            "text": "laptop",
            "value": "laptop",
            "selected": false
          }
        ],
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Fleet Health — is each daemon ticking",
      "collapsed": false,
      "id": 100,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "title": "Liveness — daemon × node (lines last 10m; red 0 = silent/down)",
      "description": "Recent log volume per daemon×node. 0 (red)=silent/wedged, orange=low, green=healthy.",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service_name, catalyst_node_name) (count_over_time({service_name=~\"${service:pipe}\"} | log_file_name=~`.+` | catalyst_node_name=~\"${node:pipe}\" | label_format service_name=`{{ trimPrefix \"catalyst.\" .service_name }}` [10m]))",
          "refId": "A",
          "queryType": "instant",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value": "count",
              "Value #A": "count"
            }
          }
        },
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "catalyst_node_name",
            "rowField": "service_name",
            "valueField": "count",
            "emptyValue": "zero"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            },
            "minWidth": 80
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 10
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "mini"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mini-2"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "laptop"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Volume & error rate over time",
      "collapsed": false,
      "id": 101,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "panels": []
    },
