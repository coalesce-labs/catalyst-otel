          "legendFormat": "liveness warmer: refresh failed",
          "instant": true
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"${service:pipe}\"} | log_file_name=~`.+` | catalyst_node_name=~\"${node:pipe}\" |= `stale fence` [$__range])) or vector(0)",
          "refId": "D",
          "queryType": "instant",
          "legendFormat": "stale fence",
          "instant": true
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"${service:pipe}\"} | log_file_name=~`.+` | catalyst_node_name=~\"${node:pipe}\" |= `tick failed` [$__range])) or vector(0)",
