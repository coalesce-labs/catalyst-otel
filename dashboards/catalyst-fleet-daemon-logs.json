    {
      "id": 6,
      "type": "logs",
      "title": "WARN / ERROR / FATAL feed",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"${service:pipe}\"} | log_file_name=~`.+` | catalyst_node_name=~\"${node:pipe}\" | level=~`40|50|60` | label_format sev=`{{ if eq .level \"30\" }}INFO{{ else if eq .level \"40\" }}WARN{{ else if eq .level \"50\" }}ERROR{{ else if eq .level \"60\" }}FATAL{{ else }}L{{ .level }}{{ end }}` | line_format `[{{ .catalyst_node_name }}] {{ .service_name }} {{ .sev }} | {{ __line__ }}`",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 31
      }
    },
    {
      "id": 7,
      "type": "table",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "title": "Top error/warn clusters (message prefix)",
      "description": "Heuristic clustering: groups WARN+ lines by their leading non-numeric message prefix (IDs/tails stripped).",
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (cluster) (count_over_time({service_name=~\"${service:pipe}\"} | log_file_name=~`.+` | catalyst_node_name=~\"${node:pipe}\" | level=~`40|50|60` | regexp `^(?P<cluster>[^0-9—\\n]{3,55})` [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value #A",
            "desc": true
          }
        ]
      },
      "transformations": [],
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 42
      }
    },
