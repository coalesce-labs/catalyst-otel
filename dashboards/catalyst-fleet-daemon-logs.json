        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"${service:pipe}\"} | log_file_name=~`.+` | catalyst_node_name=~\"${node:pipe}\" |= `holding new-work dispatch` [$__range])) or vector(0)",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": "holding new-work dispatch",
          "instant": true
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"${service:pipe}\"} | log_file_name=~`.+` | catalyst_node_name=~\"${node:pipe}\" |~ `reconcile( poll)? failed` [$__range])) or vector(0)",
          "refId": "B",
          "queryType": "instant",
          "legendFormat": "reconcile failed",
          "instant": true
        },
        {
