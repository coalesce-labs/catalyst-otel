          "refId": "F",
          "queryType": "instant",
          "legendFormat": "registry has 0 projects",
          "instant": true
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=~\"${service:pipe}\"} | log_file_name=~`.+` | catalyst_node_name=~\"${node:pipe}\" |= `not in the cluster roster` [$__range])) or vector(0)",
          "refId": "G",
          "queryType": "instant",
          "legendFormat": "not in the cluster roster",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
