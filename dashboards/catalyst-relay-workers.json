      "id": 2,
      "type": "stat",
      "title": "Tickets in flight",
      "description": "Distinct catalyst_ticket values with a live (non-expired) token series. Prometheus expires a series 15m after its last sample, so this is 'active in roughly the last 15 minutes', not 'open tickets'.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "count(count by (catalyst_ticket) (claude_code_token_usage_tokens_total{catalyst_ticket=~\"$ticket\",catalyst_ticket!=\"\"}))",
