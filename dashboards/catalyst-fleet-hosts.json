    {
      "id": 66,
      "type": "table",
      "title": "Top Processes by RSS — $hostname",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (process_command) (max_over_time({service_name=\"catalyst.agent\"} |= \"host.process.sampled\" | host_name=~\"$hostname\" | unwrap process_rss_mb | __error__=\"\" [$__range]) by (process_command, process_ticket, process_phase)))",
          "queryType": "instant",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (process_command) (max_over_time({service_name=\"catalyst.agent\"} |= \"host.process.sampled\" | host_name=~\"$hostname\" | unwrap process_cpu_pct | __error__=\"\" [$__range]) by (process_command, process_ticket, process_phase))",
          "queryType": "instant",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "process_command",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "process_command": "Command",
              "Value #A": "RSS MB",
              "Value #B": "CPU %"
            },
            "indexByName": {
              "process_command": 0,
              "Value #A": 1,
              "Value #B": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": "",
            "sort": [
              {
                "field": "RSS MB",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "RSS MB"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decmbytes"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1024
                    },
                    {
                      "color": "red",
                      "value": 4096
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 50
                    },
                    {
                      "color": "red",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "countRows": false,
          "fields": ""
        }
      },
      "repeat": "hostname",
      "repeatDirection": "h",
      "maxPerRow": 2,
      "description": "Top commands by total RSS on each host (sum of per-process max over the range) with CPU%. One table per selected host (exact host_name match, no mini/mini-2 overlap)."
    },
