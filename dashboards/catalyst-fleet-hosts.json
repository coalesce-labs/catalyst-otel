    {
      "id": 65,
      "type": "stat",
      "title": "Host Capacity (mem / disk / CPUs)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host_name) (catalyst_host_mem_total_mb{host_name=~\"$hostname\"})",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "mem - {{host_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host_name) (catalyst_host_disk_total_gb{host_name=~\"$hostname\"})",
          "instant": true,
          "range": false,
          "refId": "B",
          "legendFormat": "disk - {{host_name}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "max by (host_name) (catalyst_host_cpu_count{host_name=~\"$hostname\"})",
          "instant": true,
          "range": false,
          "refId": "C",
          "legendFormat": "CPUs - {{host_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "A"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decmbytes"
              },
              {
                "id": "displayName",
                "value": "Memory — ${__field.labels.host_name}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decgbytes"
              },
              {
                "id": "displayName",
                "value": "Disk — ${__field.labels.host_name}"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "displayName",
                "value": "CPU cores — ${__field.labels.host_name}"
              }
            ]
          }
        ]
      },
