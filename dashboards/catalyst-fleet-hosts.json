    {
      "id": 81,
      "title": "Running Version & Commit by Host",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "expr": "catalyst_build_info",
          "format": "table",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "environment": true,
              "exported_job": true,
              "host_id": true,
              "hostname": true,
              "instance": true,
              "job": true,
              "otel_scope_name": true,
              "service_name": true,
              "service_namespace": true,
              "Value": true
            },
            "indexByName": {
              "host_name": 0,
              "service_version": 1,
              "vcs_ref_head_revision": 2
            },
            "renameByName": {
              "host_name": "Host",
              "service_version": "Version",
              "vcs_ref_head_revision": "Commit"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Host",
            "desc": false
          }
        ],
        "cellHeight": "sm"
      },
      "description": "Current catalyst-agent version and HEAD commit running on each host (catalyst_build_info). A host may briefly show two commit rows right after a deploy until the prior series expires."
    },
    {
      "id": 82,
      "title": "Commits Behind main Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 10,
        "y": 51,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (host_name) (catalyst_vcs_commits_behind)",
          "legendFormat": "{{host_name}}",
