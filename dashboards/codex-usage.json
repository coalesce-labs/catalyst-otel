      "datasource": { "type": "loki", "uid": "loki" },
      "interval": "$bucket",
      "targets": [
        {
          "expr": "sum by (linear_key) (sum_over_time({service_name=\"codex_exec\"} | event_name=\"codex.sse_event\" | linear_key!=\"\" | linear_key=~\"$linear_key\" | unwrap input_token_count [$__interval]))",
