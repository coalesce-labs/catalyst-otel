    {
      "id": 20,
      "type": "timeseries",
      "title": "Turn Latency (p50/p95)",
      "description": "codex_turn_e2e_duration_ms — Codex_Desktop / codex-app-server ONLY. Verified 2026-08-24: codex_exec (headless relay) never emits this histogram (turn e2e duration is not exported by the headless CLI). See dashboard-level note.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "$bucket",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(codex_turn_e2e_duration_ms_milliseconds_bucket{model=~\"$model\"}[$__interval])))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(codex_turn_e2e_duration_ms_milliseconds_bucket{model=~\"$model\"}[$__interval])))",
          "legendFormat": "p95 {{model}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "spanNulls": true,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "stacking": { "mode": "none", "group": "A" },
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
