{
  "uid": "codex-usage",
  "title": "Codex Usage",
  "description": "Codex (OpenAI) CLI/desktop telemetry — turns, tokens, latency, tools, and events. No cost panels (ChatGPT-subscription auth emits no cost telemetry). Sparse-event/occurrence panels use Loki count_over_time, not expired-counter increase().",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "style": "dark",
  "timezone": "browser",
  "refresh": "30s",
  "liveNow": false,
  "fiscalYearStartMonth": 0,
  "tags": ["codex", "observability"],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "annotations": { "list": [] },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "bucket",
        "type": "interval",
        "label": "Interval",
        "query": "1m,5m,15m,30m,1h,6h,1d",
        "current": { "text": "5m", "value": "5m" },
        "auto": false,
        "auto_count": 30,
        "auto_min": "10s",
        "options": [],
        "refresh": 2,
        "hide": 0
      },
      {
        "name": "model",
        "type": "query",
        "label": "Model",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "qryType": 1,
          "query": "label_values(codex_conversation_turn_count_total, model)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      },
      {
        "name": "originator",
        "type": "query",
        "label": "Originator",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "qryType": 1,
          "query": "label_values(codex_tool_call_total, originator)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      },
      {
        "name": "hostname",
        "type": "query",
        "label": "Host",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "qryType": 1,
          "query": "label_values(codex_conversation_turn_count_total, host_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 2,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Codex — Overview",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Turns",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"codex.*\"} |= \"codex.turn_ttft\" | originator=~\"$originator\" [$__range]))",
          "legendFormat": "Turns",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(codex_turn_token_usage_sum{model=~\"$model\"}[$__range]))",
          "legendFormat": "Tokens",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#5794F2", "value": null } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tool Calls",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"codex.*\"} |= \"codex.tool_result\" | originator=~\"$originator\" [$__range]))",
          "legendFormat": "Tool Calls",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#FF9830", "value": null } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache Hit Rate",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(codex_turn_token_usage_sum{token_type=~\"cached|cache.*\",model=~\"$model\"}[$__range])) / clamp_min(sum(increase(codex_turn_token_usage_sum{token_type=~\"cached|cache.*|input\",model=~\"$model\"}[$__range])), 1)",
          "legendFormat": "Cache Hit Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#F2495C", "value": null }, { "color": "#FADE2A", "value": 0.3 }, { "color": "#73BF69", "value": 0.6 } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Threads",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"codex.*\"} |= \"codex.conversation_starts\" | originator=~\"$originator\" [$__range]))",
          "legendFormat": "Threads",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#B877D9", "value": null } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "TTFT p50",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(codex_turn_ttft_seconds_bucket{model=~\"$model\"}[$__range])))",
          "legendFormat": "TTFT p50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#73BF69", "value": null }, { "color": "#FADE2A", "value": 2 }, { "color": "#F2495C", "value": 5 } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Tokens & Turns",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Token Rate by Type",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "$bucket",
      "targets": [
        {
          "expr": "sum by (token_type) (rate(codex_turn_token_usage_sum{model=~\"$model\"}[$__interval]))",
          "legendFormat": "{{token_type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "stacking": { "mode": "normal", "group": "A" },
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Turn Rate by Model",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "$bucket",
      "targets": [
        {
          "expr": "sum by (model) (rate(codex_conversation_turn_count_total{model=~\"$model\",originator=~\"$originator\",host_name=~\"$hostname\"}[$__interval]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "stacking": { "mode": "none", "group": "A" },
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Tokens by Model",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "$bucket",
      "targets": [
        {
          "expr": "sum by (model) (rate(codex_turn_token_usage_sum{model=~\"$model\"}[$__interval]))",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "stacking": { "mode": "none", "group": "A" },
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum", "mean"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Turn Latency (p50/p95)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "$bucket",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le, model) (rate(codex_turn_e2e_seconds_bucket{model=~\"$model\"}[$__interval])))",
          "legendFormat": "p50 {{model}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(codex_turn_e2e_seconds_bucket{model=~\"$model\"}[$__interval])))",
          "legendFormat": "p95 {{model}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "spanNulls": true,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "stacking": { "mode": "none", "group": "A" },
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "TTFT / TTFM Latency (p50/p95)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "$bucket",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(codex_turn_ttft_seconds_bucket{model=~\"$model\"}[$__interval])))",
          "legendFormat": "TTFT p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(codex_turn_ttft_seconds_bucket{model=~\"$model\"}[$__interval])))",
          "legendFormat": "TTFT p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(codex_turn_ttfm_seconds_bucket{model=~\"$model\"}[$__interval])))",
          "legendFormat": "TTFM p50",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(codex_turn_ttfm_seconds_bucket{model=~\"$model\"}[$__interval])))",
          "legendFormat": "TTFM p95",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "spanNulls": true,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "stacking": { "mode": "none", "group": "A" },
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "Tools",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "panels": []
    },
    {
      "id": 30,
      "type": "barchart",
      "title": "Tool Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sort_desc(topk(15, sum by (tool) (increase(codex_tool_call_total{originator=~\"$originator\"}[$__range]))))",
          "format": "table",
          "instant": true,
          "legendFormat": "{{tool}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "legend": { "showLegend": false }
      }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Tool Success Rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "interval": "$bucket",
      "targets": [
        {
          "expr": "sum(rate(codex_tool_call_total{success=\"true\",originator=~\"$originator\"}[$__interval])) / clamp_min(sum(rate(codex_tool_call_total{originator=~\"$originator\"}[$__interval])), 0.0001)",
          "legendFormat": "Success Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "spanNulls": true,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "stacking": { "mode": "none", "group": "A" },
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "#F2495C", "value": null }, { "color": "#FADE2A", "value": 0.8 }, { "color": "#73BF69", "value": 0.95 } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean"] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 500,
      "type": "row",
      "title": "Logs",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "panels": []
    },
    {
      "id": 40,
      "type": "logs",
      "title": "Codex Events",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{service_name=~\"codex.*\"} |= \"codex.\" | originator=~\"$originator\" | line_format \"[{{.originator}}] {{.event_name}} {{.tool}}\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    },
    {
      "id": 41,
      "type": "logs",
      "title": "Codex Errors",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": false,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{service_name=~\"codex.*\"} |~ \"error|api_error\" | originator=~\"$originator\"",
          "queryType": "range",
          "refId": "A"
        }
      ]
    }
  ]
}
