{
  "description": "Per-person Claude Code usage, keyed on the `operator` resource attribute. Use when more than one person shares an Anthropic account: the user.* attributes are identical for everyone on a shared account, so `operator` is the only reliable discriminator. Series with no `operator` label are matched by the All selector.",
  "editable": true,
  "id": null,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": [],
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Sum of the per-session cost counter's maximum within the selected range.",
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(max_over_time(claude_code_cost_usage_USD_total{operator=~\"$operator\"}[$__range])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Estimated cost",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "blue",
            "mode": "fixed"
          },
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(max_over_time(claude_code_token_usage_tokens_total{operator=~\"$operator\"}[$__range])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Tokens",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "purple",
            "mode": "fixed"
          },
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(max_over_time(claude_code_session_count_total{operator=~\"$operator\"}[$__range])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Sessions",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Counts claude_code.user_prompt events. This includes local slash commands such as /status and /effort, which never call the API \u2014 so this can exceed the number of sessions that show tokens or cost.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "orange",
            "mode": "fixed"
          },
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"claude-code.*\"} |= \"claude_code.user_prompt\" | operator=~\"$operator\" [$__range])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Prompts sent",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "green",
            "mode": "fixed"
          },
          "decimals": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(max_over_time(claude_code_lines_of_code_count_total{operator=~\"$operator\"}[$__range])) or vector(0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Lines changed",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": [],
      "title": "Activity",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cumulative spend, not a rate. Prometheus expires idle series after 15m, so rate() over sparse Claude Code counters reads near-zero and is misleading.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "spanNulls": true
          },
          "min": 0,
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 280,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        }
      },
      "targets": [
        {
          "expr": "sum by (operator) (max_over_time(claude_code_cost_usage_USD_total{operator=~\"$operator\"}[$__interval]))",
          "legendFormat": "{{operator}}",
          "refId": "A"
        }
      ],
      "title": "Cumulative cost by operator",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Cumulative token counts. Same reason as the cost panel: rate() is unreliable on sparse counters.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "spanNulls": true
          },
          "min": 0,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "width": 280,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true
        }
      },
      "targets": [
        {
          "expr": "sum by (type) (max_over_time(claude_code_token_usage_tokens_total{operator=~\"$operator\"}[$__interval]))",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "title": "Cumulative tokens by type",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (model) (max_over_time(claude_code_token_usage_tokens_total{operator=~\"$operator\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "title": "Model mix (tokens)",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "options": {
        "legend": {
          "showLegend": false
        },
        "orientation": "horizontal"
      },
      "targets": [
        {
          "expr": "sort_desc(topk(10, sum by (tool_name) (count_over_time({service_name=~\"claude-code.*\"} |= \"claude_code.tool_result\" | operator=~\"$operator\" [$__range]))))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top tools",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max",
            "sum"
          ],
          "sortBy": "Total",
          "sortDesc": true
        }
      },
      "targets": [
        {
          "expr": "sum by (operator) (count_over_time({service_name=~\"claude-code.*\"} |= \"claude_code.user_prompt\" | operator=~\"$operator\" [$__auto]))",
          "legendFormat": "{{operator}}",
          "refId": "A"
        }
      ],
      "title": "Prompts over time",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "panels": [],
      "title": "What they actually did",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Full prompt text. Requires OTEL_LOG_USER_PROMPTS=1 on the client. Everyone on the team is logged this way, Ryan included.",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "options": {
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service_name=~\"claude-code.*\"} |= \"claude_code.user_prompt\" | operator=~\"$operator\" | line_format \"[{{.operator}}] {{.prompt}}\"",
          "refId": "A"
        }
      ],
      "title": "Prompts",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Requires OTEL_LOG_TOOL_DETAILS=1 on the client.",
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "options": {
        "enableLogDetails": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service_name=~\"claude-code.*\"} |= \"claude_code.tool_result\" | operator=~\"$operator\" | line_format \"[{{.operator}}] {{.tool_name}} success={{.success}} {{.duration_ms}}ms\"",
          "refId": "A"
        }
      ],
      "title": "Tool calls",
      "type": "logs"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Every session that started, including ones that never called the API. Blank tokens/cost means the session only ran local slash commands.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "sum by (operator, host_name, session_id) (max_over_time(claude_code_session_count_total{operator=~\"$operator\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (session_id, model) (max_over_time(claude_code_token_usage_tokens_total{operator=~\"$operator\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum by (session_id) (max_over_time(claude_code_cost_usage_USD_total{operator=~\"$operator\"}[$__range]))",
          "format": "table",
          "instant": true,
          "refId": "C"
        }
      ],
      "title": "Sessions",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "session_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "indexByName": {
              "host_name": 1,
              "model": 3,
              "operator": 0,
              "session_id": 2
            },
            "renameByName": {
              "Value #A": "sessions",
              "Value #B": "tokens",
              "Value #C": "cost (USD)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "desc": true,
                "field": "tokens"
              }
            ]
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "panels": [],
      "title": "Conversation",
      "type": "row"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Interleaves claude_code.user_prompt and claude_code.assistant_response by timestamp. Slash commands such as /status never call the model, so they appear as a USER line with no CLAUDE reply. The two events share a prompt_id if you need to pair them exactly.",
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "direction": "forward",
          "expr": "{service_name=~\"claude-code.*\"} | event_name=~\"user_prompt|assistant_response\" | operator=~\"$operator\" | session_id=~\"$session\" | line_format \"{{ if eq .event_name \\\"user_prompt\\\" }}\u25b6 USER    {{ .prompt }}{{ else }}\u25c0 CLAUDE  {{ .response }}{{ end }}\"",
          "refId": "A"
        }
      ],
      "title": "Conversation (prompts and responses, oldest first)",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": [
    "claude-code",
    "operator",
    "usage"
  ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "includeAll": true,
        "label": "Operator",
        "multi": true,
        "name": "operator",
        "query": "label_values(claude_code_token_usage_tokens_total, operator)",
        "refresh": 2,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "description": "Cascades from Operator and the dashboard time range. Pick one session to read it end to end.",
        "includeAll": true,
        "label": "Session",
        "multi": true,
        "name": "session",
        "query": "label_values(claude_code_session_count_total{operator=~\"$operator\"}, session_id)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Operator Usage",
  "uid": "operator-usage",
  "version": 6
}
