{
  "uid": "operator-usage",
  "title": "Operator Usage",
  "description": "Per-person Claude Code usage, keyed on the `operator` resource attribute. Use when more than one person shares an Anthropic account: the user.* attributes are identical for everyone on a shared account, so `operator` is the only reliable discriminator. Series with no `operator` label are matched by the All selector.",
  "tags": [
    "claude-code",
    "operator",
    "usage"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "operator",
        "label": "Operator",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values({__name__=~\"claude_code_token_usage_tokens_total|claude_code_session_count_total\"}, operator)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(claude_code_session_count_total{operator=~\"$operator\"}, session_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "description": "Cascades from Operator and the dashboard time range. Pick one session to read it end to end."
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Estimated cost",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_cost_usage_USD_total{operator=~\"$operator\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Estimated cost increase within the selected time range."
    },
    {
      "type": "stat",
      "title": "Tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_token_usage_tokens_total{operator=~\"$operator\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_session_count_total{operator=~\"$operator\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Prompts sent",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=~\"claude-code.*\"} |= \"claude_code.user_prompt\" | operator=~\"$operator\" [$__range])) or vector(0)",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "description": "Counts claude_code.user_prompt events. This includes local slash commands such as /status and /effort, which never call the API \u2014 so this can exceed the number of sessions that show tokens or cost."
    },
    {
      "type": "stat",
      "title": "Lines changed",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(claude_code_lines_of_code_count_total{operator=~\"$operator\"}[$__range])) or vector(0)",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "Activity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Cumulative cost by operator",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operator) (increase(claude_code_cost_usage_USD_total{operator=~\"$operator\"}[$__interval]))",
          "legendFormat": "{{operator}}"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "cumulativeFunctions",
            "cumulative": {
              "reducer": "sum"
            },
            "replaceFields": true
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "always",
            "spanNulls": true,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "Cumulative spend within the selected window. Uses increase() per interval accumulated via the cumulativeTotal transform — counts only cost added during the window, not prior history."
    },
    {
      "type": "timeseries",
      "title": "Cumulative tokens by type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (increase(claude_code_token_usage_tokens_total{operator=~\"$operator\"}[$__interval]))",
          "legendFormat": "{{type}}"
        }
      ],
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "cumulativeFunctions",
            "cumulative": {
              "reducer": "sum"
            },
            "replaceFields": true
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "always",
            "spanNulls": true,
            "drawStyle": "line",
            "lineInterpolation": "stepAfter"
          },
          "min": 0
        },
        "overrides": []
      },
      "description": "Cumulative token counts within the selected window. Uses increase() per interval accumulated via the cumulativeTotal transform."
    },
    {
      "type": "piechart",
      "title": "Model mix (tokens)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (increase(claude_code_token_usage_tokens_total{operator=~\"$operator\"}[$__range]))",
          "legendFormat": "{{model}}",
          "instant": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "barchart",
      "title": "Top tools",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sort_desc(topk(10, sum by (tool_name) (count_over_time({service_name=~\"claude-code.*\"} |= \"claude_code.tool_result\" | operator=~\"$operator\" [$__range]))))",
          "queryType": "instant"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Prompts over time",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operator) (count_over_time({service_name=~\"claude-code.*\"} |= \"claude_code.user_prompt\" | operator=~\"$operator\" [$__auto]))",
          "legendFormat": "{{operator}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "What they actually did",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "logs",
      "title": "Prompts",
      "description": "Full prompt text. Requires OTEL_LOG_USER_PROMPTS=1 on the client. Everyone on the team is logged this way, Ryan included.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"claude-code.*\"} |= \"claude_code.user_prompt\" | operator=~\"$operator\" | line_format \"[{{.operator}}] {{.prompt}}\""
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "type": "logs",
      "title": "Tool calls",
      "description": "Requires OTEL_LOG_TOOL_DETAILS=1 on the client.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 11,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"claude-code.*\"} |= \"claude_code.tool_result\" | operator=~\"$operator\" | line_format \"[{{.operator}}] {{.tool_name}} success={{.success}} {{.duration_ms}}ms\""
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "enableLogDetails": true
      }
    },
    {
      "type": "table",
      "title": "Sessions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "format": "table",
          "expr": "sum by (operator, host_name, session_id) (increase(claude_code_session_count_total{operator=~\"$operator\"}[$__range]))"
        },
        {
          "refId": "B",
          "instant": true,
          "format": "table",
          "expr": "sum by (session_id) (increase(claude_code_token_usage_tokens_total{operator=~\"$operator\"}[$__range]))"
        },
        {
          "refId": "C",
          "instant": true,
          "format": "table",
          "expr": "sum by (session_id) (increase(claude_code_cost_usage_USD_total{operator=~\"$operator\"}[$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "session_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "Value #A": "sessions",
              "Value #B": "tokens",
              "Value #C": "cost (USD)"
            },
            "indexByName": {
              "operator": 0,
              "host_name": 1,
              "session_id": 2
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "tokens",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "description": "Every session that started, including ones that never called the API. Blank tokens/cost means the session only ran local slash commands."
    },
    {
      "type": "row",
      "title": "Conversation",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "logs",
      "title": "Conversation (prompts and responses, oldest first)",
      "description": "Interleaves claude_code.user_prompt and claude_code.assistant_response by timestamp. Slash commands such as /status never call the model, so they appear as a USER line with no CLAUDE reply. The two events share a prompt_id if you need to pair them exactly.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"claude-code.*\"} | event_name=~\"user_prompt|assistant_response\" | operator=~\"$operator\" | session_id=~\"$session\" | line_format \"{{ if eq .event_name \\\"user_prompt\\\" }}\u25b6 USER    {{ .prompt }}{{ else }}\u25c0 CLAUDE  {{ .response }}{{ end }}\"",
          "direction": "forward"
        }
      ],
      "options": {
        "showTime": true,
        "sortOrder": "Ascending",
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      }
    }
  ]
}
