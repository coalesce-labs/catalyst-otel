{
  "uid": "catalyst-node-sync",
  "title": "Catalyst · Node Sync",
  "tags": ["catalyst", "node-sync", "freshness", "version"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "text",
      "title": "",
      "id": 100,
      "transparent": true,
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": { "mode": "markdown", "content": "## Catalyst · Node Sync — is every node running the latest CODE and the freshest DATA?\nNodes: **mini**, **mini-2**, **laptop** (`host_name=Ryans-MacBook-Pro-2`), **cloud** (`service_namespace=catalyst-cloud`). Two freshness axes: **CODE** = `catalyst_vcs_commits_behind` (0 = on `main`) + `catalyst_build_info` running revision; **DATA** = Linear/GitHub replica apply + staleness + cursor vs cloud head watermark.\n\n> **Coverage gaps (producer-side, honest):** code-version telemetry exists for **mini/mini-2 only** — laptop & cloud emit no `catalyst_build_info`/`commits_behind`. GitHub replica has apply *throughput* but no staleness-*age*. Cloud has head watermark but no version/heartbeat. Panels for missing signals read `No data` by design." }
    },
    { "type": "row", "title": "Headline — fleet sync at a glance", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 3 }, "id": 1, "collapsed": false },
    {
      "type": "stat", "title": "Max commits behind main", "id": 2,
      "description": "max(catalyst_vcs_commits_behind) across nodes. 0 = every reporting node is on main. (mini/mini-2 only.)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "max(catalyst_vcs_commits_behind)", "instant": true } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 10 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "stat", "title": "Running version (mini/mini-2)", "id": 3,
      "description": "catalyst_build_info service_version. Compare rev to main HEAD in the Code section.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "catalyst_build_info", "instant": true, "legendFormat": "{{service_version}}" } ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "name", "colorMode": "value", "graphMode": "none" }
    },
    {
      "type": "stat", "title": "Max Linear replica staleness", "id": 4,
      "description": "Worst local Linear replica age across nodes (catalyst.linear.replica.staleness, ms).",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(last_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | regexp `\"catalyst.linear.replica.staleness\":(?P<v>[0-9]+)` | unwrap v [5m]))", "queryType": "instant" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30000 }, { "color": "red", "value": 120000 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "stat", "title": "Replica apply failures (24h)", "id": 5,
      "description": "catalyst.replica.apply result=failed over 24h. Currently all = linear/issues state_id schema drift (OTL-42 / catalyst-cloud#127).",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum(count_over_time({service_name=\"catalyst.cloud-sync\"} |= `catalyst.replica.apply` |= `\"result\":\"failed\"` [24h]))", "queryType": "instant" } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "stat", "title": "Cloud head watermark (linear)", "id": 6,
      "description": "catalyst.mirror.ingest.committed headSeq for source=linear — the cloud's freshness anchor.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service_namespace=\"catalyst-cloud\"} |= `ingest.committed` |= `\"source\":\"linear\"` | regexp `\"headSeq\":(?P<h>[0-9]+)` | unwrap h [10m]))", "queryType": "instant" } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "type": "stat", "title": "Nodes replicating", "id": 7,
      "description": "Distinct host_name emitting replica.apply in the last 10m (expect 3: mini, mini-2, laptop).",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "count(sum by (host_name)(count_over_time({service_name=\"catalyst.cloud-sync\"} |= `catalyst.replica.apply` [10m])))", "queryType": "instant" } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 3 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" }
    },
    { "type": "row", "title": "CODE freshness — is each node on the latest main?", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }, "id": 10, "collapsed": false },
    {
      "type": "table", "title": "Running code per node (build_info): version + revision", "id": 11,
      "description": "What each node is actually RUNNING. Compare `vcs_ref_head_revision` to main HEAD. If commits_behind=0 but the revision is an OLD sha with no recent reload, the daemon pulled code but didn't restart. mini/mini-2 only — laptop & cloud emit no build_info.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "catalyst_build_info", "instant": true, "format": "table" } ],
      "transformations": [ { "id": "organize", "options": { "excludeByName": { "__name__": true, "Time": true, "Value": true, "job": true, "instance": true, "environment": true, "service_name": true, "otel_scope_name": true, "exported_job": true, "service_namespace": true, "host_id": true, "hostname": true, "catalyst_node_class": true, "service_instance_id": true, "resource_environment": true }, "indexByName": { "host_name": 0, "service_version": 1, "vcs_ref_head_revision": 2 }, "renameByName": { "host_name": "node", "service_version": "version", "vcs_ref_head_revision": "revision" } } } ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true }
    },
    {
      "type": "timeseries", "title": "Commits behind main per node (0 = on main)", "id": 12,
      "description": "catalyst_vcs_commits_behind by node. A step up = the node fell behind origin/main (needs a code pull); back to 0 = caught up. mini/mini-2 only.",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "catalyst_vcs_commits_behind", "legendFormat": "{{host_name}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 15, "stepAfter": true, "lineWidth": 2, "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "logs", "title": "Code-pull vs restart timeline (plugin.checkout.updated · stack.reload.complete · broker.daemon.startup)", "id": 13,
      "description": "When each node last re-checked-out code and restarted. A plugin.checkout.updated with NO following stack.reload.complete = code pulled but daemon not restarted (running stale). mini/mini-2.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 15 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{service_name=~\"catalyst\\\\.(execution-core|broker)\"} |~ `plugin.checkout.updated|stack.reload.complete|broker.daemon.startup` | line_format `{{.host_name}}  {{.event_name}}`", "queryType": "range" } ],
      "options": { "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none" }
    },
    { "type": "row", "title": "DATA freshness — replica sync (Linear + GitHub)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "id": 20, "collapsed": false },
    {
      "type": "timeseries", "title": "Linear replica staleness per node (age, ms)", "id": 21,
      "description": "catalyst.linear.replica.staleness — how far behind live each node's local Linear replica is. Healthy = low single-digit seconds.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 23 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "avg_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | regexp `\"catalyst.linear.replica.staleness\":(?P<s>[0-9]+)` | unwrap s [$__interval]) by (host_name)", "queryType": "range", "legendFormat": "{{host_name}}" } ],
      "fieldConfig": { "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "max", "mean"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Replica cursor per node + cloud head watermark (Linear)", "id": 22,
      "description": "Per-node catalyst.linear.replica.cursor vs the cloud headSeq(linear). Shown as separate series (node cursor and cloud head are related but NOT the same seq space — do not read a naive subtraction as lag).",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "last_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | regexp `\"catalyst.linear.replica.cursor\":(?P<c>[0-9]+)` | unwrap c [$__interval]) by (host_name)", "queryType": "range", "legendFormat": "cursor {{host_name}}" },
        { "refId": "B", "datasource": { "type": "loki", "uid": "loki" }, "expr": "max(max_over_time({service_namespace=\"catalyst-cloud\"} |= `ingest.committed` |= `\"source\":\"linear\"` | regexp `\"headSeq\":(?P<h>[0-9]+)` | unwrap h [$__interval]))", "queryType": "range", "legendFormat": "cloud headSeq (linear)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2 } }, "overrides": [ { "matcher": { "id": "byName", "options": "cloud headSeq (linear)" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash" } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last"] }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Replica apply rate by source & result (Linear + GitHub)", "id": 23,
      "description": "catalyst.replica.apply throughput. source=linear + source=github (this is the GitHub-replica signal — throughput, since no staleness-age is emitted). result=failed shown in red.",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 37 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "sum by (source, result)(count_over_time({service_name=\"catalyst.cloud-sync\"} |= `catalyst.replica.apply` | regexp `\"result\":\"(?P<result>[a-z]+)\"` | regexp `\"source\":\"(?P<source>[a-z_]+)\"` [$__interval]))", "queryType": "range", "legendFormat": "{{source}} {{result}}" } ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [ { "matcher": { "id": "byRegexp", "options": ".*failed.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["last", "sum"] }, "tooltip": { "mode": "multi" } }
    },
    { "type": "row", "title": "Per-node — mini", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 }, "id": 30, "collapsed": false },
    { "type": "stat", "title": "mini · commits behind", "id": 31, "gridPos": { "h": 4, "w": 4, "x": 0, "y": 45 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "catalyst_vcs_commits_behind{host_name=\"mini\"}", "instant": true } ], "fieldConfig": { "defaults": { "decimals": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },
    { "type": "stat", "title": "mini · running rev", "id": 32, "gridPos": { "h": 4, "w": 5, "x": 4, "y": 45 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "catalyst_build_info{host_name=\"mini\"}", "instant": true, "legendFormat": "{{vcs_ref_head_revision}}" } ], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "name", "colorMode": "value" } },
    { "type": "stat", "title": "mini · Linear staleness", "id": 33, "gridPos": { "h": 4, "w": 5, "x": 9, "y": 45 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "last_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | host_name=`mini` | regexp `\"catalyst.linear.replica.staleness\":(?P<v>[0-9]+)` | unwrap v [5m])", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30000 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },
    { "type": "stat", "title": "mini · cursor", "id": 34, "gridPos": { "h": 4, "w": 5, "x": 14, "y": 45 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "last_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | host_name=`mini` | regexp `\"catalyst.linear.replica.cursor\":(?P<c>[0-9]+)` | unwrap c [5m])", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none" } },
