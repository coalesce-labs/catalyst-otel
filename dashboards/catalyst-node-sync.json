    { "type": "stat", "title": "mini-2 · running rev", "id": 42, "gridPos": { "h": 4, "w": 5, "x": 4, "y": 50 }, "datasource": { "type": "prometheus", "uid": "prometheus" }, "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "catalyst_build_info{host_name=\"mini-2\"}", "instant": true, "legendFormat": "{{vcs_ref_head_revision}}" } ], "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "name", "colorMode": "value" } },
    { "type": "stat", "title": "mini-2 · Linear staleness", "id": 43, "gridPos": { "h": 4, "w": 5, "x": 9, "y": 50 }, "datasource": { "type": "loki", "uid": "loki" }, "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "last_over_time({service_name=\"catalyst.cloud-sync\"} |= `cloud-sync: freshness` | host_name=`mini-2` | regexp `\"catalyst.linear.replica.staleness\":(?P<v>[0-9]+)` | unwrap v [5m])", "queryType": "instant" } ], "fieldConfig": { "defaults": { "unit": "ms", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 30000 } ] } } }, "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" } },
