        {
          "expr": "(sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=\"input\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range])) or vector(0)) + (sum(increase(codex_turn_token_usage_sum{token_type=\"input\"}[$__range])) or vector(0)) + (sum(increase(opencode_llm_input_tokens_total{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[$__range])) or vector(0))",
          "legendFormat": "input",
          "refId": "A"
