    {
      "id": 16,
      "type": "row",
      "title": "④ Latency & Reliability",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "LLM Call Latency p95 by Harness",
      "description": "claude = api_request_duration_seconds · codex = turn_e2e_duration_ms (÷1000) · opencode = llm_duration_seconds. Different call shapes (request vs turn vs span) — treat cross-harness gaps as directional, not exact.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(claude_code_api_request_duration_seconds_bucket{job=\"otel-collector\"}[5m])))",
          "legendFormat": "claude",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(codex_turn_e2e_duration_ms_milliseconds_bucket[5m]))) / 1000",
          "legendFormat": "codex",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(opencode_llm_duration_seconds_bucket{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[5m])))",
          "legendFormat": "opencode",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
