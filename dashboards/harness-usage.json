          "legendFormat": "cache read",
          "refId": "B"
        },
        {
          "expr": "(sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=\"output\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range])) or vector(0)) + (sum(increase(codex_turn_token_usage_sum{token_type=\"output\"}[$__range])) or vector(0)) + (sum(increase(opencode_llm_output_tokens_total{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[$__range])) or vector(0))",
