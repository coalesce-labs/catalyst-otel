          "expr": "sum(increase(claude_code_api_error_total{job=\"otel-collector\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range])) / clamp_min(sum(increase(claude_code_api_request_total{job=\"otel-collector\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range])), 1)",
          "legendFormat": "claude",
