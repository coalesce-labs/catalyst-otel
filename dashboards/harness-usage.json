{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "① Tokens & Calls — all harnesses (OTL-100)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Tokens (in + out)",
      "description": "Input+output tokens across Claude Code (native OTLP), Codex (native histogram sum), and OpenCode (derived from ai.* spans). Excludes cache reads and reasoning so harnesses sum without double-counting.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=~\"input|output\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range])) or vector(0)) + (sum(increase(codex_turn_token_usage_sum{token_type=~\"input|output\"}[$__range])) or vector(0)) + ((sum(increase(opencode_llm_input_tokens_total{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[$__range])) or vector(0)) + (sum(increase(opencode_llm_output_tokens_total{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[$__range])) or vector(0)))",
          "legendFormat": "tokens",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#5794F2", "value": null }] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "LLM Calls / Turns",
      "description": "Claude API requests + Codex conversation turns + OpenCode LLM calls. Semantics differ slightly per harness (request vs turn vs call) — see per-harness dashboards for exact definitions.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(sum(increase(claude_code_api_request_total{job=\"otel-collector\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range])) or vector(0)) + (sum(increase(codex_conversation_turn_count_total[$__range])) or vector(0)) + (sum(increase(opencode_llm_calls_total{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[$__range])) or vector(0))",
          "legendFormat": "calls",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#73BF69", "value": null }] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cache Hit Rate",
      "description": "Cache-read share of input tokens across the harnesses that report it: claude type=cacheRead, codex token_type=cached_input, opencode cachedInputTokens. Denominator clamped to 1 so zero usage reads 0%, not an error.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "((sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=\"cacheRead\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range])) or vector(0)) + (sum(increase(codex_turn_token_usage_sum{token_type=\"cached_input\"}[$__range])) or vector(0)) + (sum(increase(opencode_llm_cached_input_tokens_total{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[$__range])) or vector(0))) / clamp_min(((sum(increase(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=\"input\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range])) or vector(0)) + (sum(increase(codex_turn_token_usage_sum{token_type=\"input\"}[$__range])) or vector(0)) + (sum(increase(opencode_llm_input_tokens_total{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[$__range])) or vector(0))), 1)",
          "legendFormat": "cache hit",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#F2495C", "value": null },
              { "color": "#F2CC0C", "value": 0.5 },
              { "color": "#73BF69", "value": 0.75 }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Spend (measured: Claude only)",
      "description": "Only Claude Code exports a measured cost counter (claude_code_cost_usage_USD_total). Codex (ChatGPT subscription) and OpenCode (GLM/Qwen token-plan) emit no cost telemetry — never read this as fleet spend.",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(claude_code_cost_usage_USD_total{job=\"otel-collector\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range])) or vector(0)",
          "legendFormat": "USD",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#FF9830", "value": null }] },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false, "fields": "" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Token Rate by Harness (in + out, per second)",
      "description": "claude = native claude_code_token_usage (input|output) · codex = codex_turn_token_usage_sum (input|output) · opencode = opencode_llm_{input,output}_tokens_total.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(claude_code_token_usage_tokens_total{job=\"otel-collector\",type=~\"input|output\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[5m]))",
          "legendFormat": "claude",
          "refId": "A"
        },
        {
          "expr": "sum(rate(codex_turn_token_usage_sum{token_type=~\"input|output\"}[5m]))",
          "legendFormat": "codex",
          "refId": "B"
        },
        {
          "expr": "sum(rate(opencode_llm_input_tokens_total{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[5m])) + sum(rate(opencode_llm_output_tokens_total{project=~\"$project\",branch=~\"$branch\",host_name=~\"$hostname\"}[5m]))",
          "legendFormat": "opencode",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "stacking": { "mode": "none" } },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["max", "mean", "sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM Calls / Turns by Harness (increase over range)",
      "description": "Per-harness interaction counts. Codex emits no project/branch/host attribution labels, so its series are fleet-wide by design.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(claude_code_api_request_total{job=\"otel-collector\",project=~\"$project\",branch=~\"$branch\",hostname=~\"$hostname\"}[$__range]))",
          "legendFormat": "claude",
          "refId": "A"
        },
        {
          "expr": "sum(increase(codex_conversation_turn_count_total[$__range]))",
          "legendFormat": "codex",
          "refId": "B"
