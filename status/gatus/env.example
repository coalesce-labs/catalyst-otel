# Names only. Real values live in ~/catalyst-status/.env on mini (mode 600), never in git.
# Resend API key, the same secret the mirror sends alert mail with (EMAIL_API_KEY).
RESEND_API_KEY=
# Shared secret for the mirror's POST /api/v1/alerts/notify (the Grafana contact point uses the same one).
CATALYST_ALERT_WEBHOOK_SECRET=
# ClickHouse agent_reader password (read-only user, capped).
CLICKHOUSE_AGENT_READER_PASSWORD=
# Cloudflare Access service token for otel-collector.catalystcloud.dev.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Org API key with ONLY mirror:read, minted for this page (WorkOS key id api_key_01M356G9NJK33VNH54RM2TZ7D4).
CATALYST_STATUS_READ_KEY=
# Bearer token the laptop pusher presents for the external endpoint replica_laptop-writer.
REPLICA_PUSH_TOKEN=
